rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // shareExpiresAt is unix seconds, set when the owner shares a list
    function isGroceryListShareActive() {
      return resource.data.shareExpiresAt is number
        && request.time.toMillis() / 1000 < resource.data.shareExpiresAt;
    }

    match /recipes/{documentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /grocery-lists/{documentId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Shared link: read + check-off sync while the 7-day window is active
      allow read: if isGroceryListShareActive();
      allow update: if isGroceryListShareActive();
    }

    match /recipe-favorites/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == docId;
    }

    match /artifacts/{appId}/users/{userId}/profiles/{profileId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Clients may update profile identity fields, but not billing / AI quota fields
      // (those are written by Cloud Functions with the Admin SDK).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'aiImportUsed',
          'aiImportLimit',
          'aiImportPlan',
          'aiImportUpdatedAt',
          'stripeCustomerId',
          'stripeSubscriptionId'
        ]);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'aiImportUsed',
          'aiImportLimit',
          'aiImportPlan',
          'aiImportUpdatedAt',
          'stripeCustomerId',
          'stripeSubscriptionId'
        ]);

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
