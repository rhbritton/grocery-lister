{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "target": "app",
      "public": "build",
      "ignore": [
        "firebase.json",
        "**/node_modules/**",
        "**/.git/**"
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [{ "key": "Content-Type", "value": "application/json" }]
        }
      ],
      "predeploy": ["npm run build"]
    },
    {
      "target": "marketing",
      "public": "website",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.md"]
    }
  ]
}
